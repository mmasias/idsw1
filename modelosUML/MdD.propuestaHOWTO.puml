@startuml
!theme plain
skinparam backgroundColor transparent

start
:Elegir la semilla;
note right
  No conozco el dominio: la organización
  Conozco el dominio: la entidad central
end note

repeat
  :Tomar un concepto;
  :Narrar qué pasa con él
  (con el cliente, en sus palabras);
  note right: Diagramas de actividad
  :Decidir qué hay que recordar;
  note right
    ¿Entidad, atributo o verbo?
    ¿Hay un acto o una relación que cosificar?
    Diagrama de clases · Frontera
  end note
  :Nombrar lo que no se entiende;
  note right: Preguntas y decisiones
  :Comprobar con un escenario concreto;
  note right: Diagramas de objetos
  :Recapitular;
  note right
    Glosario · Reglas de negocio
    Diagramas de estados
  end note
  if (¿Ha aparecido la entidad central\ny la semilla era la organización?) then (sí)
    :Cambiar de semilla:
    crecer desde la entidad central;
  else (no)
  endif
repeat while (¿Quedan colaboradores por tomar\no preguntas abiertas?) is (sí)
-> no;

:Modelo del dominio;
stop

@enduml
